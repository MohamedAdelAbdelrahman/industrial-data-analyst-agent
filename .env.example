# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- LLM provider: "google" (free tier, AI Studio key) or "anthropic" ---
LLM_PROVIDER=google
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
PLANNER_MODEL=gemini-3.5-flash
EXECUTOR_MODEL=gemini-3.1-flash-lite
# Anthropic equivalents: PLANNER_MODEL=claude-sonnet-5-5, EXECUTOR_MODEL=claude-haiku-5-5

# --- Text-to-SQL backend: "llm" (LLM writes SQL) or "finetuned" (local model via Ollama) ---
SQL_BACKEND=llm
SQL_LLM_MODEL=gemini-3.1-flash-lite
FINETUNED_SQL_MODEL=ida-sql
OLLAMA_URL=http://localhost:11434

# --- Langfuse (Step 7) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
