# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-sonnet-5-5
EXECUTOR_MODEL=claude-haiku-5-5

# --- Text-to-SQL backend: "llm" (Claude writes SQL) or "finetuned" (local model via Ollama) ---
SQL_BACKEND=llm
SQL_LLM_MODEL=claude-haiku-5-5
FINETUNED_SQL_MODEL=ida-sql
OLLAMA_URL=http://localhost:11434

# --- Langfuse (Step 7) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
