# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- LLM provider: "google" (free tier, AI Studio key) or "anthropic" ---
LLM_PROVIDER=google
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
# Model pools, tried in order; a model out of free quota is skipped until it resets (ida.model_pool).
# Leave unset to use the defaults in src/ida/config.py.
# PLANNER_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# EXECUTOR_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3-flash-preview,gemma-4-26b-a4b-it
# Anthropic equivalents: PLANNER_MODELS=claude-sonnet-5-5, EXECUTOR_MODELS=claude-haiku-5-5

# --- Text-to-SQL backend: "llm" (LLM writes SQL) or "finetuned" (local model via Ollama) ---
SQL_BACKEND=llm
# SQL_LLM_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemma-4-31b-it
FINETUNED_SQL_MODEL=ida-sql
OLLAMA_URL=http://localhost:11434

# --- Langfuse (Step 7) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # US region: https://us.cloud.langfuse.com
